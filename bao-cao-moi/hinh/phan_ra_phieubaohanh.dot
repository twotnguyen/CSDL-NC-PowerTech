digraph G {
  rankdir=TB; splines=polyline; nodesep=0.5; ranksep=0.75; pad=0.25;
  node [fontname="Helvetica", fontsize=12, margin="0.18,0.1"]; edge [fontname="Helvetica", fontsize=10.5, color="#444444"];
  q [shape=plaintext, label=<<TABLE BORDER="1" COLOR="#6C8EBF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#F8CECC"><B>Q: PHIEUBAOHANH (ban đầu)</B></TD></TR><TR><TD ALIGN="LEFT"><U>MaPhieuBH</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2E7D32">MaSeri</FONT></TD></TR><TR><TD ALIGN="LEFT">MaSP</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2E7D32">MaDH</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2E7D32">SoDongDH</FONT></TD></TR><TR><TD ALIGN="LEFT">…</TD></TR></TABLE>>];
  pth [shape=note, style=filled, fillcolor="#FFFFFF", color="#999999", label=<PTH bắc cầu:<BR/><B>MaDH,SoDongDH → MaSP</B><BR/><B>MaSeri → MaSP</B>>];
  q1 [shape=plaintext, label=<<TABLE BORDER="1" COLOR="#6C8EBF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#DAE8FC"><B>Q<SUB>1</SUB> = CHITIETDONHANG (đã có)</B></TD></TR><TR><TD ALIGN="LEFT"><U>MaDH</U></TD></TR><TR><TD ALIGN="LEFT"><U>SoDongDH</U></TD></TR><TR><TD ALIGN="LEFT">MaSP</TD></TR><TR><TD ALIGN="LEFT">…</TD></TR></TABLE>>];
  q2 [shape=plaintext, label=<<TABLE BORDER="1" COLOR="#6C8EBF" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#D5E8D4"><B>Q<SUB>2</SUB>: PHIEUBAOHANH (sau cải tiến)</B></TD></TR><TR><TD ALIGN="LEFT"><U>MaPhieuBH</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2E7D32">MaSeri</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2E7D32">MaDH</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#2E7D32">SoDongDH</FONT></TD></TR><TR><TD ALIGN="LEFT">…</TD></TR></TABLE>>];
  q -> q1 [label="tách theo\nMaDH,SoDongDH → MaSP"]; q -> q2 [label="bỏ MaSP"]; pth -> q [style=dashed, arrowhead=none];
  { rank=same; q; pth }
}