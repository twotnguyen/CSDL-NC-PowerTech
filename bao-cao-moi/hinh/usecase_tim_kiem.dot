digraph G {
  rankdir=LR; splines=true; nodesep=0.45; ranksep=1.6; pad=0.25; newrank=true;
  node [fontname="Helvetica"]; edge [fontname="Helvetica", fontsize=11, color="#444444"];
  "bh" [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><IMG SRC="/Users/twot/Documents/CODE/PowerTech/bao-cao-moi/tools/../hinh/_actor_xanh.png"/></TD></TR><TR><TD>Bán hàng</TD></TR></TABLE>>, fontsize=13];
  "cs" [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><IMG SRC="/Users/twot/Documents/CODE/PowerTech/bao-cao-moi/tools/../hinh/_actor_xanh.png"/></TD></TR><TR><TD>Chăm sóc<BR/>khách hàng</TD></TR></TABLE>>, fontsize=13];
  "ql" [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><IMG SRC="/Users/twot/Documents/CODE/PowerTech/bao-cao-moi/tools/../hinh/_actor_xanh.png"/></TD></TR><TR><TD>Quản lý</TD></TR></TABLE>>, fontsize=13];
  "kh" [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD><IMG SRC="/Users/twot/Documents/CODE/PowerTech/bao-cao-moi/tools/../hinh/_actor_do.png"/></TD></TR><TR><TD>Khách hàng</TD></TR></TABLE>>, fontsize=13];
  subgraph cluster_sys { label=<<B>Tìm kiếm</B>>; labeljust=l; fontsize=15; fontname="Helvetica"; style=filled; fillcolor="#F4F8FD"; color="#6C8EBF"; penwidth=1.6;
    "d1" [shape=ellipse, style=filled, fillcolor="#FFF2CC", color="#D6B656", fontsize=13, margin="0.2,0.1", label=<Tìm mặt hàng theo loại,<BR/>thương hiệu, thông số>];
    "d2" [shape=ellipse, style=filled, fillcolor="#FFF2CC", color="#D6B656", fontsize=13, margin="0.2,0.1", label=<Tra cứu lịch sử<BR/>mua hàng của khách>];
    "d3" [shape=ellipse, style=filled, fillcolor="#FFF2CC", color="#D6B656", fontsize=13, margin="0.2,0.1", label=<Truy vết chiếc hàng<BR/>theo số seri>];
    "d4" [shape=ellipse, style=filled, fillcolor="#FFF2CC", color="#D6B656", fontsize=13, margin="0.2,0.1", label=<Tra cứu bảo hành,<BR/>đổi trả của đơn>];
    "d5" [shape=ellipse, style=filled, fillcolor="#FFF2CC", color="#D6B656", fontsize=13, margin="0.2,0.1", label=<Xem tình trạng đơn<BR/>của tôi>];
    "d6" [shape=ellipse, style=filled, fillcolor="#FFF2CC", color="#D6B656", fontsize=13, margin="0.2,0.1", label=<Truy trách nhiệm:<BR/>ai xử lý từng bước đơn>];
  }
  "kh" -> "d1" [arrowhead=none];
  "kh" -> "d5" [arrowhead=none];
  "bh" -> "d1" [arrowhead=none];
  "bh" -> "d2" [arrowhead=none];
  "cs" -> "d2" [arrowhead=none];
  "cs" -> "d3" [arrowhead=none];
  "cs" -> "d4" [arrowhead=none];
  "ql" -> "d3" [arrowhead=none];
  "ql" -> "d6" [arrowhead=none];
  { rank=min; "bh"; "cs"; "ql"; }
  { rank=max; "kh"; }
}